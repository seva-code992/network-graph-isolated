# Copy to .env (docker compose reads it automatically). Use an absolute path: compose does not expand "~".
EMBEDDINGS_HOST_DIR=/home/seva/Work/plantgenie-api/pg-data/embeddings

# "neo4j" = real experiments/expression values (run: docker compose --profile neo4j up); default "mock"
EXPERIMENT_SOURCE=mock
# Neo4j used when EXPERIMENT_SOURCE=neo4j (default: the one running on this machine)
NEO4J_URI=bolt://host.docker.internal:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=guest123
